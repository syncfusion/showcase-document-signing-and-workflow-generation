# Syncfusion license key. Set it as an environment variable before npm install / npm start (do not commit a key):
#   Windows:     setx SYNCFUSION_LICENSE "your-key"   (then open a new terminal)
#   macOS/Linux: export SYNCFUSION_LICENSE="your-key"
# `npm start` and `npm run build` run `npx syncfusion-license activate`, which reads it.
SYNCFUSION_LICENSE=
